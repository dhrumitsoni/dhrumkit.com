---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpg';
import { getPosts } from '../lib/posts';
import { SITE } from '../site';

const count = (await getPosts()).length;
---
<Base title={SITE.title} current="about">
  <div class="dim page-rule" aria-hidden="true"><span class="t"></span><span class="l"></span><span class="t"></span></div>

  <main class="about">
    <div class="portrait">
      <div class="tone">
        <Image src={portrait} alt="Dhrumit" width={311} densities={[1, 2]} loading="eager" />
      </div>
      <span class="c tl" aria-hidden="true"></span><span class="c tr" aria-hidden="true"></span>
      <span class="c bl" aria-hidden="true"></span><span class="c br" aria-hidden="true"></span>
    </div>

    <div class="text">
      <div class="name">
        <h1>Dhrumit</h1>
        <p class="role">Data engineer.</p>
      </div>
      <p>I build the data platforms that products and decisions sit on: batch and streaming pipelines, warehouses and lakehouses, orchestration, modelling, and the backend services around them. I write about data infrastructure and about software engineering in general.</p>
      <p>Prev: <a href="https://ollion.com/">@Ollion</a>, <a href="https://www.simform.com/">@Simform</a>.</p>

      <a class="writing" href="/writing/">
        <span class="label">Writing <span class="arrow" aria-hidden="true">→</span></span>
        <span class="dim" aria-hidden="true"><span class="t"></span><span class="l"></span><span class="t"></span></span>
        <span class="count">{count} {count === 1 ? 'post' : 'posts'}</span>
      </a>

      <ul class="links">
        {SITE.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/rss.xml">rss</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
  </main>

  <p class="domain-note">dhrumkit.com (yes, like drum kit)</p>
</Base>

<style>
  .about {
    flex: 1;
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    padding: 40px 18px 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    align-items: flex-start;
    gap: 32px 48px;
  }
  @media (min-width: 640px) { .about { padding: clamp(48px, 8vh, 72px) 24px 0; } }

  /* Portrait: cyanotype re-tone (field shadows → bone highlights) + crop marks */
  .portrait { position: relative; flex: none; width: 120px; height: 120px; margin: 8px; }
  .tone { position: absolute; inset: 0; overflow: hidden; background: var(--field); isolation: isolate; }
  .tone :global(img) {
    position: absolute; width: 311px; height: auto; max-width: none; left: -105px; top: -90px;
    filter: grayscale(1) contrast(1.3) brightness(1.08); mix-blend-mode: screen;
  }
  .tone::after { content: ''; position: absolute; inset: 0; background: var(--paper); mix-blend-mode: multiply; }
  .c { position: absolute; width: 8px; height: 8px; border: 0 solid var(--cyan); }
  .tl { top: -8px; left: -8px; border-top-width: 1px; border-left-width: 1px; }
  .tr { top: -8px; right: -8px; border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: -8px; left: -8px; border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: -8px; right: -8px; border-bottom-width: 1px; border-right-width: 1px; }

  .text { flex: 1 1 320px; min-width: 0; max-width: 540px; display: flex; flex-direction: column; gap: 22px; }
  .name { display: flex; flex-direction: column; gap: 8px; }
  h1 { margin: 0; font: 500 clamp(34px, 5vw, 40px)/1.05 var(--serif); letter-spacing: -0.01em; color: var(--field); }
  .role { margin: 0; font: italic 20px var(--serif); color: var(--cyan); }
  .text > p { margin: 0; font-size: clamp(18px, 1.6vw, 19px); line-height: 1.62; text-wrap: pretty; }

  .writing { display: flex; align-items: center; gap: 14px; margin-top: 10px; padding: 6px 0; color: var(--field); text-decoration: none; }
  .writing:hover { color: var(--rust); }
  .writing .label { display: flex; align-items: baseline; gap: 8px; font: 500 24px var(--serif); }
  .writing .arrow { display: inline-block; transition: transform 180ms ease-out; }
  .writing:hover .arrow, .writing:focus-visible .arrow { transform: translateX(6px); }
  .writing .dim { flex: 1; }
  .writing .count { font: 12.5px var(--mono); color: var(--cyan); }

  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; font: 12.5px var(--mono); }
  .links a { display: inline-block; padding: 10px 0; }

  .domain-note { margin: 0; padding: 48px var(--edge) clamp(24px, 5.5vh, 44px); text-align: right; font: 12px var(--mono); color: var(--cyan); }
  @media (max-width: 639px) { .domain-note { text-align: left; } }
</style>
