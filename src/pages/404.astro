---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---
<Base title={`Not found · ${SITE.name}`} description="This page does not exist.">
  <div class="dim page-rule" aria-hidden="true"><span class="t"></span><span class="l"></span><span class="t"></span></div>
  <main class="post-grid article-body">
    <div class="prose">
      <p class="code">ERR. 404 — NOT FOUND</p>
      <h1>Nothing at this address.</h1>
      <p>The page may have moved. Try the <a href="/writing/">writing index</a> or go <a href="/">home</a>.</p>
    </div>
  </main>
</Base>

<style>
  .code { margin: 0 0 12px; font: 12px var(--mono); letter-spacing: 0.06em; color: var(--rust); }
  h1 { margin: 0 0 24px; font: 500 var(--h2)/1.2 var(--serif); color: var(--field); }
</style>
